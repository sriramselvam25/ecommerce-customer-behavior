Total Revenue = SUM(FactCustomerPerformance[Revenue])
Total Customers = DISTINCTCOUNT(FactCustomerPerformance[CustomerID])
Total Orders = SUM(FactCustomerPerformance[Orders])
Average Order Value = DIVIDE([Total Revenue], [Total Orders])
Gross Profit = [Total Revenue] - SUM(FactCustomerPerformance[Cost])
Gross Margin % = DIVIDE([Gross Profit], [Total Revenue])
Revenue PY = CALCULATE([Total Revenue], DATEADD(DimDate[Date], -1, YEAR))
YoY Growth % = DIVIDE([Total Revenue]-[Revenue PY],[Revenue PY])
Target Revenue = SUM(FactCustomerPerformance[TargetValue])
Target Attainment % = DIVIDE([Total Revenue],[Target Revenue])
